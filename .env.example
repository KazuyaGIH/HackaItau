# Provider OpenAI-compatible (chat completions + json mode). Nunca entra em prompt.
# Gemini (free tier): https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=60
# 429/5xx (sobrecarga, rate limit) são repetidos com backoff exponencial: 2s, 4s, 8s, ...
LLM_MAX_RETRIES=5
LLM_RETRY_BACKOFF_SECONDS=2

# OpenAI, se preferir:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Pré-carrega demanda demo e habilita demo_options (documento adversarial)
DEMO_MODE=true
